# Vercel AI Gateway uses VERCEL_OIDC_TOKEN automatically on Vercel.
# Set AI_GATEWAY_API_KEY only when OIDC is unavailable.
AI_GATEWAY_API_KEY=
# Production uses the fixed model failover chain in code.
ENABLE_SIMULATOR=false

DATABASE_URL=
# Canonical public origin used for generated Content Studio creative URLs and Facebook publication images.
PUBLIC_URL=https://sales.medmindslc.online

# Meta Facebook Page publishing for Content Studio / Facebook Scheduler.
# Create or reuse a Meta app with Facebook Login, then register this redirect URI:
# https://sales.medmindslc.online/api/admin/facebook/callback
META_FACEBOOK_APP_ID=
META_FACEBOOK_APP_SECRET=
META_FACEBOOK_GRAPH_VERSION=v25.0
META_FACEBOOK_TARGET_PAGE_NAME=MedMinds Learning Centre
# Optional: use a separate encryption secret for the Page token stored in Neon.
# If blank, SESSION_SECRET is used to derive the encryption key.
FACEBOOK_TOKEN_ENCRYPTION_KEY=
# Optional static Page connection fallback. OAuth is preferred.
MEDMINDS_FACEBOOK_PAGE_ID=
MEDMINDS_FACEBOOK_PAGE_ACCESS_TOKEN=

# Canva Connect API for Content Studio manual/template workflow.
# Create a Canva Developer integration and register this OAuth redirect URI:
# https://sales.medmindslc.online/api/admin/canva/callback
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# Optional: use a separate encryption secret for Canva tokens stored in Neon.
# If blank, SESSION_SECRET is used to derive the encryption key.
CANVA_TOKEN_ENCRYPTION_KEY=

# Meta WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=
# Enabled by default. Set to false if you do not want clients to see "typing..." while the AI prepares a reply.
WHATSAPP_TYPING_INDICATOR=true

# Legacy approved follow-up templates are retained for compatibility with historical follow-up records.
# The scheduled follow-up cron now creates HUMAN follow-up tasks and internal notifications; it does not auto-message clients.
WHATSAPP_FOLLOWUP_TEMPLATE_NAME=medminds_followup
WHATSAPP_FOLLOWUP_TEMPLATE_LANGUAGE=en_US
# Optional stage-specific APPROVED Meta templates retained for historical/legacy follow-up tooling.
WHATSAPP_FOLLOWUP_TEMPLATE_1_NAME=
WHATSAPP_FOLLOWUP_TEMPLATE_2_NAME=
WHATSAPP_FOLLOWUP_TEMPLATE_3_NAME=
WHATSAPP_FOLLOWUP_TEMPLATE_4_NAME=
WHATSAPP_FOLLOWUP_TEMPLATE_5_NAME=
# Optional per-stage language overrides. Leave blank to use WHATSAPP_FOLLOWUP_TEMPLATE_LANGUAGE.
WHATSAPP_FOLLOWUP_TEMPLATE_1_LANGUAGE=
WHATSAPP_FOLLOWUP_TEMPLATE_2_LANGUAGE=
WHATSAPP_FOLLOWUP_TEMPLATE_3_LANGUAGE=
WHATSAPP_FOLLOWUP_TEMPLATE_4_LANGUAGE=
WHATSAPP_FOLLOWUP_TEMPLATE_5_LANGUAGE=
# Review request template outside the 24-hour window.
WHATSAPP_REVIEW_TEMPLATE_NAME=
WHATSAPP_REVIEW_TEMPLATE_LANGUAGE=en_US
# Receipt notification template used only when the 24-hour service window is closed.
# The current implementation sends the approved template as the notification; full receipt details remain stored in the admin conversation record.
WHATSAPP_RECEIPT_TEMPLATE_NAME=
WHATSAPP_RECEIPT_TEMPLATE_LANGUAGE=en_US

# Africa's Talking SMS for HUMAN follow-up messages.
# Use username=sandbox and AFRICASTALKING_SANDBOX=true for the sandbox environment.
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
# Optional approved sender ID / shortcode. Leave blank to use the account default.
AFRICASTALKING_SENDER_ID=
AFRICASTALKING_SANDBOX=false

# Explee AutoGTM hot-lead import. Keep the API key server-side only.
EXPLEE_API_KEY=
EXPLEE_PROJECT_ID=39070

# Required for Vercel Cron. Cron routes reject requests without this exact Bearer secret.
CRON_SECRET=

# Restricted Research Portal task bridge. Use the SAME long random secret on
# medmindslc.online. The endpoint can only create unassigned research tasks.
RESEARCH_ASSISTANT_SECRET=
RESEARCH_PORTAL_TASK_URL=https://www.medmindslc.online/api/research/assistant-admin/tasks

ADMIN_PASSWORD=
SESSION_SECRET=
