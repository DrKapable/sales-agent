# Vercel AI Gateway uses VERCEL_OIDC_TOKEN automatically on Vercel.
# Set AI_GATEWAY_API_KEY only when OIDC is unavailable.
AI_GATEWAY_API_KEY=
# The production app uses a fixed failover chain: GPT-5.6 Luna, GPT-5.6 Sol, then GPT-5.4.
# AI_MODEL is intentionally not used to pin production chat to an older model.
# Keep false in production unless the public simulator is intentionally enabled.
ENABLE_SIMULATOR=false

# Durable storage. A Neon/Postgres DATABASE_URL is recommended.
DATABASE_URL=

# Meta WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=

# Automated follow-ups. Create/approve this template in WhatsApp Manager for messages sent outside the 24-hour service window.
WHATSAPP_FOLLOWUP_TEMPLATE_NAME=medminds_followup
WHATSAPP_FOLLOWUP_TEMPLATE_LANGUAGE=en_US
# Optional but recommended. Vercel Cron will send this as a Bearer token when configured.
CRON_SECRET=

# Admin access. Use long, unique values.
ADMIN_PASSWORD=
SESSION_SECRET=
